{
  "buffer_font_weight": 500.0,
  "buffer_font_family": "Maple Mono NL NF CN",
  "experimental.theme_overrides": {
    "syntax": {
      "attribute": {
        "font_style": "italic"
      },
      "boolean": {
        "font_style": "italic"
      },
      "keyword": {
        "font_style": "italic"
      },
      "comment": {
        "font_style": "italic"
      },
      "function": {
        "font_weight": 300,
        "font_style": "normal"
      },
    }
  },
  "terminal": {
    "font_family": "Maple Mono NL NF CN"
  },
  "diff_view_style": "split",
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "bottom_dock_layout": "contained",
  "preview_tabs": {
    "enable_preview_from_file_finder": true
  },
  "tabs": {
    "file_icons": true,
    "git_status": false
  },
  "tab_bar": {
    "show": true
  },
  "title_bar": {
    "show_menus": false,
    "show_sign_in": false,
    "show_user_picture": true,
    "show_onboarding_banner": true,
    "show_branch_name": true,
  },
  "project_panel": {
    "dock": "left",
    "button": true
  },
  "preferred_line_length": 65,
  "ui_font_family": "Maple Mono NL NF CN",
  "prettier": {
    "allowed": false,
  },
  "format_on_save": "on",
  "helix_mode": false,
  "vim_mode": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme"
  },
  "ui_font_size": 17.0,
  "buffer_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "Ayu Mirage",
    "dark": "Ayu Dark"
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": false
  },
  "lsp": {
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "golangci-lint",
          "run",
          "--output.json.path",
          "stdout",
          "--show-stats=false",
          "--output.text.path="
        ]
      }
    }
  },
  "languages": {
    "Go HTML Template": {
      "language_servers": [
        "gopls",
        "emmet-language-server"
      ]
    },
    "Nix": {
      "language_servers": [
        "nixd",
        "!nil"
      ]
    },
    "Go": {
      "language_servers": [
        "gopls",
        "golangci-lint"
      ]
    }
  }
}
