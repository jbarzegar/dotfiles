#!/bin/bash
autoload -Uz compinit
compinit
# aliases
alias vi="nvim"
alias vim="nvim"
alias reload="source ~/.zshrc"
alias cls="clear"
# chezmoi alias
alias cz="chezmoi"
## Git things
alias glz="lazygit"
alias kubectl="kubecolor"

LG_CONFIG_BASE="$HOME/Library/Application Support/lazygit/"
export LG_CONFIG_FILE="$LG_CONFIG_BASE/theme.yml,$LG_CONFIG_BASE/config.yml"
export EDITOR="hx"
export PATH="$PATH:$HOME/.local/bin"
export TERM_THEME="Catppuccin Mocha"

[ -s "$HOME/.scm_breeze/scm_breeze.sh" ] && source "$HOME/.scm_breeze/scm_breeze.sh"

# inits
eval "$(mise activate zsh)"
eval "$(zoxide init zsh)"
eval "$(oh-my-posh init zsh --config ~/.config/oh-my-posh/themes/pure.omp.json)"

zi () {
  zoxide query -i
}

# override zoxide's default z behaviour
# uses an interactive search if no args provided
# otherwise will act as the default
z () {
  out="$*"
  # interactive on empty input
  if [[ $out == "" ]]; then
    __zoxide_cd "$(zoxide query -i)" || exit 1
  else
    __zoxide_z "$@"
  fi
}

